{
  "description": "Complete Claude project workflow mapped to Codex lifecycle events.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact|fork",
      "hooks": [{
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lifecycle.mjs\" session",
        "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lifecycle.mjs\" session",
        "timeout": 90,
        "statusMessage": "AegisPay: syncing Dev B and loading checklist/handoff"
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context.mjs\" route",
        "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context.mjs\" route",
        "timeout": 10
      }]
    }],
    "PostToolUse": [{
      "matcher": "Bash|exec_command|write_stdin",
      "hooks": [{
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lifecycle.mjs\" test",
        "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lifecycle.mjs\" test",
        "timeout": 120
      }]
    }],
    "PreToolUse": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lifecycle.mjs\" rules",
        "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lifecycle.mjs\" rules",
        "timeout": 10
      }]
    }]
  }
}
